APP_NAME=DayLog
DEBUG=true
BASE_URL=http://127.0.0.1:8000        # public URL of the site, used for cookies + Google redirect
SECRET_KEY=change-me                   # python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_DAYS=7

# Neon: copy the connection string from the Neon dashboard and change the prefix to postgresql+psycopg://
# Keep sslmode=require. Use a separate Neon branch for development.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email delivery (email verification links) --------------------------------
# New email/password accounts must confirm their address before they can sign
# in. Pick ONE backend and fill its settings. If none is configured, signup
# still creates the account but reports that the email could not be sent.
#
# EMAIL_BACKEND: "smtp" or "resend". Leave blank to auto-detect
# (a RESEND_API_KEY selects resend, otherwise SMTP_HOST selects smtp).
EMAIL_BACKEND=
# The From address. Must be a domain you are allowed to send from
# (e.g. no-reply@yourdomain.com). Required for either backend.
EMAIL_FROM=
EMAIL_FROM_NAME=DayLog
EMAIL_TIMEOUT_SECONDS=20

# Option A — SMTP (Gmail app password, Postmark, Mailgun, SES, …)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Option B — Resend (https://resend.com), called over HTTPS
RESEND_API_KEY=

# Verification token lifetime and resend throttling.
VERIFICATION_TOKEN_TTL_HOURS=24
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_RESEND_WINDOW_SECONDS=900
VERIFICATION_RESEND_MAX_PER_WINDOW=5

LLM_PROVIDER=gemini                    # "gemini" or "groq"
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

DEFAULT_TIMEZONE=Asia/Kolkata

# Dev only: extra browser origins allowed to make unsafe requests (Vite dev server).
# Leave empty in production so only BASE_URL's origin is accepted.
DEV_ALLOWED_ORIGINS=

# Production frontend origin(s) allowed to make unsafe (CSRF-checked) requests.
# Needed when the frontend is hosted on a different origin than BASE_URL, e.g. a
# Vercel deployment (including per-branch preview URLs). Comma-separated, exact
# origins only. Keep DEV_ALLOWED_ORIGINS empty in production; use this instead.
FRONTEND_ORIGINS=

# Local testing only (scripts/smoke_test.py)
SMOKE_LLM_KEY=
